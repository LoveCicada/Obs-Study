  "cards": [
    {
      "dot": "cyan",
      "title": "视频主路径",
      "items": [
        "图形线程每帧: tick 源 → 渲染源树 → RGBA→NV12 转换 → 回读上一帧乒乓纹理",
        "同一循环内 render_displays 把主纹理绘制到预览窗口交换链",
        "帧缓存上限 16 帧, 编码器跟不上时复制上一帧, 表现为跳帧",
        "时间戳贯穿全管线, 输出端按 DTS 交织保证音画同步"
      ]
    },
    {
      "dot": "violet",
      "title": "音频路径",
      "items": [
        "采集侧随时推送: 滤镜 → 重采样 → 每源环形缓冲 audio_input_buf",
        "音频线程每 1024 采样(48kHz 约 21.3ms)拉取快照, 自叶向根树形混音",
        "音量/静音/按压通话按时间戳在样本级生效, 另送监听设备"
      ]
    },
    {
      "dot": "emerald",
      "title": "GPU 零拷贝旁路",
      "items": [
        "NVENC 等 GPU 编码器直接消费图形纹理, 不经过 CPU 回读",
        "独立 gpu_encode_thread 通过纹理队列与信号量驱动",
        "一个编码器可同时服务推流与录制多个输出, 编码只做一次"
      ]
    },
    {
      "dot": "amber",
      "title": "输出与可靠性",
      "items": [
        "obs_output 交织队列把音视频包按单调时间戳排序后回调插件",
        "RTMP 输出有独立发送线程与断线重连线程",
        "录制文件由 ffmpeg-mux 子进程写入, 崩溃时可恢复"
      ]
    }
  ]
}